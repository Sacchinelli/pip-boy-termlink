# Copie este arquivo para .env e preencha a sua chave.
# Crie a chave (gratuita) em: https://aistudio.google.com/apikey
GEMINI_API_KEY=cole_sua_chave_aqui

# Opcional: modelo Live a usar (deixe vazio para o padrão do programa).
# GEMINI_MODEL=

# Opcional: atalhos globais (funcionam dentro do jogo).
# HOTKEY_TOGGLE=ctrl+alt+p
# HOTKEY_MUTE=ctrl+alt+m
# HOTKEY_GAME_AUDIO=ctrl+alt+g
# HOTKEYS_GLOBAIS=true
